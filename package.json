{
  "name": "@happytokenai/happy-router",
  "version": "1.0.2",
  "description": "Per-app proxy routing for Clash Verge Rev on macOS",
  "type": "module",
  "bin": {
    "happy-router": "cli.js"
  },
  "main": "electron.js",
  "scripts": {
    "start": "node cli.js",
    "cli": "node cli.js",
    "web": "node cli.js --web",
    "server": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "publish": null,
    "appId": "com.happyrouter.app",
    "productName": "Happy Router",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "afterSign": "scripts/notarize.cjs",
    "files": [
      "server.js",
      "cli.js",
      "electron.js",
      "lib/**",
      "public/**"
    ]
  },
  "dependencies": {
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "simple-plist": "^1.4.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "dotenv": "^17.4.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  }
}
